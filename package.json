{
  "name": "@cynosure-mcp/chart-artifacts",
  "mcpName": "io.github.andreasjhagen/chart-artifacts",
  "version": "0.2.0",
  "description": "MCP server for rendering Vega-Lite chart artifacts as SVG or high-resolution PNG images.",
  "type": "module",
  "bin": {
    "mcp-chart-artifacts": "dist/index.js"
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "icon.png"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "release:check": "node scripts/sync-version.mjs --check",
    "version": "node scripts/sync-version.mjs && git add server.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "nanoid": "^5.1.6",
    "sharp": "^0.34.5",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cynosure-MCP-Collection/mcp-charts.git"
  },
  "homepage": "https://github.com/Cynosure-MCP-Collection/mcp-charts#readme",
  "bugs": {
    "url": "https://github.com/Cynosure-MCP-Collection/mcp-charts/issues"
  }
}
